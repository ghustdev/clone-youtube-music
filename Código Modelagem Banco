// VERSÃO ESTENDIDA (Múltiplas Classes)
// ==========================================


Table Usuario {
  id int [pk, increment]
  nome varchar [not null]
  email varchar [unique, not null]
  senha varchar [not null]
  is_admin boolean [default: false]
  criado_em timestamp
}

Table Artista {
  id int [pk, increment]
  nome varchar [not null]
  biografia text
  foto_url varchar
}

Table Album {
  id int [pk, increment]
  titulo varchar [not null]
  capa_url varchar
  ano_lancamento int
  artista_id int [ref: > Artista.id]
}

Table Genero {
  id int [pk, increment]
  nome varchar [not null, note: 'Ex: Rock, Pop, Sertanejo']
}

Table Musica {
  id int [pk, increment]
  titulo varchar [not null]
  album_id int [ref: > Album.id]
  artista_principal_id int [ref: > Artista.id]
  genero_id int [ref: > Genero.id]
  url_youtube varchar [not null]
  criado_em timestamp
}

Table Playlist {
  id int [pk, increment]
  nome varchar [not null]
  descricao varchar
  usuario_id int [not null, ref: > Usuario.id]
  criado_em timestamp
}

Table PlaylistMusica {
  playlist_id int [ref: > Playlist.id]
  musica_id int [ref: > Musica.id]
  ordem int
  adicionado_em timestamp

  indexes {
    (playlist_id, musica_id) [pk]
  }
}

Table HistoricoReproducao {
  id int [pk, increment]
  usuario_id int [ref: > Usuario.id]
  musica_id int [ref: > Musica.id]
  reproduzido_em timestamp
}

Table FilaReproducao {
  id int [pk, increment]
  usuario_id int [unique, ref: - Usuario.id, note: 'Relação 1:1, cada usuário tem sua fila atual']
  atualizada_em timestamp
}

Table FilaMusica {
  fila_id int [ref: > FilaReproducao.id]
  musica_id int [ref: > Musica.id]
  ordem int

  indexes {
    (fila_id, musica_id) [pk]
  }
}
